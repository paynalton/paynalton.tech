---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MainMenu from '../components/MainMenu.astro';

const { currentPage, content_title, content_description, lang, t } = Astro.props;
const legacySections:Record<string,string>={home:'Home',about:'My Life',jobs:'My Employers',projects:'My Projects',ideas:'My Ideas',contact:'Contact'};
const sectionTitle=t._t(legacySections[currentPage]??'Home');

---
<!doctype html>
<html lang={ lang }>
	<head>
		<BaseHead title={`${sectionTitle} | ${t._t("__SITE_TITLE__")}`} description={`${sectionTitle}. ${t._t("__SITE_DESCRIPTION__")}`} keywords={ t._t("__SITE_KEYWORDS__") } lang={lang} t={t}/>
	</head>
	<body class={`page-${currentPage}`}>
		<Header  lang={lang} t={t}/>
		<main>
			<section class="top-area">
				<div class="header-area">
					<MainMenu current={currentPage} lang={lang} t={t} />
				</div>
				<div class="clearfix"></div>
	
			</section>
			<section id="home" class="welcome-hero">
				<div class="container">
					<div class="welcome-hero-txt">
						<h1>{ t._t("__SLOGAN__") }</h1>
						<p>
							{ t._t("__SUBSLOGAN__") }
						</p>
					</div>
				</div>
			</section>
			<div class="main-content">
				{ () => {
					if( content_title ){
						return (
						<section class="title">
							<div class="container mt-5">
								<div class="section-header">
									<h1>{ t._t(content_title) }</h1>
									<p class="lead">{ t._t(content_description) }</p>
								</div>
							</div>
						</section>
						);
					}
				}}				
                <slot />
            </div>
		</main>
		<Footer t={t}/>
	</body>
</html>
