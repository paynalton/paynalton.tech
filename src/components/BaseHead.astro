---
import '../styles/external-links.css';
// Import the global.css file here so that it is included on
// all pages through the use of the <BaseHead /> component.
import '../styles/template/font-awesome.min.css';
import '../styles/template/linearicons.css';
import '../styles/template/animate.css';
import '../styles/template/flaticon.css';
import '../styles/template/slick.css';
import '../styles/template/slick-theme.css';
import '../styles/template/bootstrap.min.css';
import '../styles/template/bootsnav.css';
import '../styles/template/style.css';
import '../styles/template/responsive.css';
import '../styles/global.scss';
import '../styles/taller/fonts.css';

interface Props {
	title: string;
	description: string;
	keywords: string;
	image?: string;
	lang?: string;
	t?: any;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const { title, description, image = '/taller/publication/social-es.png', keywords } = Astro.props;
---

<meta charset="utf-8">
<meta http-equiv="X-UA-Compatible" content="IE=edge">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{title}</title>

<!-- Global Metadata -->
<link rel="icon" href="/favicon.svg" type="image/svg+xml" /><link rel="icon" href="/favicon.ico" sizes="16x16 32x32" /><link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link
	rel="alternate"
	type="application/rss+xml"
	title={title}
	href={new URL('rss.xml', Astro.site)}
/>
<meta name="generator" content={Astro.generator} />

<!-- Font preloads -->
<link rel="preload" href="/fonts/atkinson-regular.woff" as="font" type="font/woff" crossorigin />
<link rel="preload" href="/fonts/atkinson-bold.woff" as="font" type="font/woff" crossorigin />
<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- Primary Meta Tags -->
<meta name="title" content={title} />
<meta name="description" content={description} />
<meta name="keywords" content={keywords} />
<meta name="author" content="Paynalton" />
<meta name="robots" content="index, follow" />

<!-- Open Graph / Facebook -->
<meta property="og:type" content="website" />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={new URL(image, Astro.site)} />

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={canonicalURL} />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={new URL(image, Astro.site)} />

<script type="application/ld+json">{"@context":"https://schema.org","@type":"Person","name":"Paynalton","url":"https://paynalton.tech","sameAs":["https://www.linkedin.com/in/paynalton","https://github.com/paynalton"]}</script>
