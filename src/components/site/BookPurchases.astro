---
import {amazonEditions} from '../../lib/site/amazon-book.mjs';
interface Props {locale:string;t:(key:string)=>string;}
const {locale,t}=Astro.props;
const editions=amazonEditions(locale);
const flag=(code:string)=>String.fromCodePoint(...(code==='UK'?'GB':code).split('').map(c=>127397+c.charCodeAt(0)));
---
<section class="book-purchases" aria-labelledby="amazon-book-title" data-amazon-book data-pagefind-ignore>
 <h2 id="amazon-book-title">{t('amazon.title')}</h2>
 <p>{t('amazon.help')}</p>
 <div class="amazon-controls" data-amazon-controls hidden>
  <fieldset><legend>{t('work.editionLabel')}</legend><div class="amazon-choices">{editions.map((e,i)=><label><input type="radio" name="amazon-language" value={e.locale} checked={i===0}/><span>{t(`amazon.edition.${e.locale}`)}</span></label>)}</div></fieldset>
  <fieldset><legend>{t('work.formatLabel')}</legend><div class="amazon-choices amazon-format-choices">{editions[0].formats.map((f,i)=><label><input type="radio" name="amazon-format" value={f.format} checked={i===0}/><span><svg aria-hidden="true" viewBox="0 0 24 28" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="4" y="2" width="16" height="23" rx={i===0?'2':'0'}/><path d={i===0?'M10 22h4':'M7 2v23M7 22h13M2 5v22h16'}/></svg>{t(`amazon.${f.format}`)}</span></label>)}</div></fieldset>
 </div>
 <div data-amazon-fallback>
 {editions.map(edition=><section data-amazon-edition={edition.locale}>
  <h3 class="amazon-edition-heading">{t(`amazon.edition.${edition.locale}`)}</h3>
  {edition.formats.map(item=>{
   const primary=item.stores.find(s=>s.code===(edition.locale==='es' && item.format==='kindle'?'MX':'US'))!;
   return <section class="amazon-format" data-amazon-format={item.format}>
    <h4 class="amazon-format-heading">{t(`amazon.${item.format}`)}</h4>
    <p class="amazon-country-label">{t('amazon.countryLabel')}</p>
    <div class="amazon-mobile-country" hidden><label for={`country-${edition.locale}-${item.format}`}>{t('amazon.countryLabel')}</label><select id={`country-${edition.locale}-${item.format}`} data-amazon-country>{item.stores.map(store=><option value={store.code} selected={store.code===primary.code}>{t(`amazon.country.${store.code.toLowerCase()}`)}</option>)}</select></div>
    <ul class="amazon-stores">{item.stores.map(store=><li><a href={store.url} data-store={store.code} target="_blank" rel="noopener noreferrer"><span class="store-flag" aria-hidden="true">{flag(store.code)}</span><span>{t(`amazon.country.${store.code.toLowerCase()}`)}<small>{new URL(store.url).hostname.replace('www.','')}</small></span></a></li>)}</ul>
    <div class="amazon-checkout"><a class="tn-action tn-action--primary" data-amazon-buy href={primary.url} target="_blank" rel="noopener noreferrer">{t('amazon.open')}</a><p>{t('amazon.newTab')}</p></div>
   </section>;
  })}
 </section>)}
 </div>
</section>
<script>import '../../scripts/book-purchases.js';</script>
