---
import LocaleLinks from '../../../components/shell/LocaleLinks.astro';
import '../../../styles/taller/system.css';
import { pageAlternatives } from '../../../lib/site/navigation.mjs';
import { loadSite } from '../../../lib/site/build.mjs';
import { createTranslator } from '../../../lib/site/i18n.mjs';
export function getStaticPaths() {
  return process.env.DESIGN_REVIEW === '1' ? ['es','en'].map(locale => ({ params: {locale} })) : [];
}
const repository = await loadSite();
const settings = repository.getSettings();
const {t} = createTranslator('es', repository.getCatalogs(), settings);
const locale = Astro.params.locale!;
const routes = ['es','en'].map(code => ({id:'translated-example', section:'home', locale:code, url:`/design-review/locales/${code}/`}));
const alternatives = pageAlternatives(routes, routes[0], settings);
---
<!doctype html><html lang="es"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="robots" content="noindex,nofollow"/><title>{t('locale.selectorLabel')}</title></head>
<body class="taller"><main class="tn-section tn-stack"><h1>{t('locale.selectorLabel')}</h1><p>{t('review.notice')}</p>
<div data-equivalent><LocaleLinks alternatives={alternatives} locale={locale} label={t('locale.selectorLabel')}/></div>
<div data-no-equivalent><LocaleLinks alternatives={alternatives.filter(item=>item.locale===locale)} locale={locale} label={t('locale.selectorLabel')}/></div>
</main></body></html>
